

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  CLIENT
  DATA_COLLECTOR
  SUPERVISOR
  ADMIN
}

enum PropertyStatus {
  PENDING
  ASSIGNED
  IN_FIELDWORK
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  PUBLISHED
  SOLD
  ARCHIVED
}

enum Condition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_RENOVATION
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  LAND
  COMMERCIAL
}

enum RoadAccessType {
  PAVED
  UNPAVED
  DIRT
  UNDER_CONSTRUCTION
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

enum ValuationMethod {
  AI
  MANUAL
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum InvitationStatus {
  PENDING
  COMPLETED  
  EXPIRED
  CANCELLED
}

// USER MODELS

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true)
  isEmailVerified Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addedById           String?
  addedBy             User?         @relation("AdminAddsEmployee", fields: [addedById], references: [id])
  

  properties          Property[]    @relation("ClientProperties")

  assignments         Assignment[]  @relation("CollectorAssignments")

  reviews             Review[]      @relation("SupervisorReviews")

  employees           User[]        @relation("AdminAddsEmployee")
   invitationsCreated  Invitation[]   @relation("AdminCreatesInvitation")
  

  assignedProperties  Assignment[]  @relation("AdminAssignments")

  savedProperties     SavedProperty[]

  uploadedImages      Image[]       @relation("ImageUploader")

  auditLogs           AuditLog[]

  generatedReports Report[]
  

  @@index([email])
  @@index([role])
  @@map("users")
}

model Invitation {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  role          Role
  token         String   @unique
  expiresAt     DateTime
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
   createdById   String
  createdBy     User     @relation("AdminCreatesInvitation", fields: [createdById], references: [id])
  
  
  @@index([token])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// image model

model Image {
   id          String   @id @default(cuid())
  url         String
  publicId    String?
  altText     String?
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  uploadedBy  String
  fileSize    Int?
  mimeType    String?
  uploader    User      @relation("ImageUploader", fields: [uploadedBy], references: [id])

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([uploadedBy])
  @@map("images")
}


// PROPERTY MODELS

model Property {
  id            String          @id @default(cuid())
  upiNumber     String          @unique
  idOrTin       String
  phoneNumber   String
  ownerName     String
  country       String          @default("Rwanda")
  province      String
  district      String
  sector        String
  cell          String
  village       String
  status        PropertyStatus  @default(PENDING)

  aiValuation   Float?
  aiConfidence  Float?
  aiFactors     Json?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  soldAt        DateTime?
  archivedAt    DateTime?
  statusChangedAt DateTime?

  client        User            @relation("ClientProperties", fields: [clientId], references: [id])
  clientId      String

  fieldData     FieldData?

  assignment    Assignment?

  reviews       Review[]

  images        Image[]

  savedBy       SavedProperty[]
  inquiries     Inquiry[]
  reports       Report[]

  @@index([status])
  @@index([clientId])
  @@index([province, district])
  @@index([createdAt])
  @@map("properties")
}

// ASSIGNMENT MODEL

model Assignment {
  id                  String    @id @default(cuid())
  assignedAt          DateTime  @default(now())
  emailSentAt         DateTime?
  verifiedAt          DateTime?
  verificationToken   String    @unique @default(cuid())
  notes               String?

  property            Property  @relation(fields: [propertyId], references: [id])
  propertyId          String    @unique

  collector           User      @relation("CollectorAssignments", fields: [collectorId], references: [id])
  collectorId         String

  assignedBy          User?     @relation("AdminAssignments", fields: [assignedById], references: [id])
  assignedById        String?

  @@index([collectorId])
  @@index([assignedById])
  @@index([verificationToken])
  @@index([assignedAt])
  @@map("assignments")
}

// FIELD DATA

model FieldData {
  id                  String          @id @default(cuid())

  latitude            Float
  longitude           Float
  gpsCapturedAt       DateTime?
  gpsAccuracy         Float?

  propertyType        PropertyType?
  condition           Condition?
  bedrooms            Int?
  bathrooms           Float?
  landSize            Float?
  buildingSize        Float?
  yearBuilt           Int?
  parkingSpaces       Int?            @default(0)

 hasGarden           Boolean?  @default(false)
  gardenSize          Float?                        
  gardenType          String?                       
  hasAnnex            Boolean?  @default(false)
  annexType           String?                      
  annexSize           Float?                        
  annexBedrooms       Int?
  annexBathrooms      Float?
  hasGate             Boolean?  @default(false)
  gateType            String?                       
  gateMaterial        String?                       
  hasFence            Boolean?  @default(false)
  fenceType           String?                      
  fenceHeight         Float?    
  hasElectricity    Boolean? @default(true)
  hasWaterSupply    Boolean? @default(true)
  hasWaterTank      Boolean? @default(false)
  floodRisk         Boolean? @default(false)
  landSlope         String?   
  floorMaterial     String?   
  roofType          String?   

  propertyCategory  String?   
  nearestSchoolKm     Float?
  nearestHospitalKm   Float?
  nearestTransportKm  Float?
  nearestMarketKm     Float?
  roadAccessType      RoadAccessType?

  valuationAmount     Float?
  valuationConfidence Float?
  valuationMethod     ValuationMethod?

  notes               String?

  submittedAt         DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  property            Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId          String          @unique

  @@index([propertyId])
  @@index([submittedAt])
  @@map("field_data")
}

// REVIEW MODEL

model Review {
  id            String          @id @default(cuid())
  comment       String
  decision      ReviewDecision
  createdAt     DateTime        @default(now())

  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String

  supervisor    User            @relation("SupervisorReviews", fields: [supervisorId], references: [id])
  supervisorId  String

  @@index([propertyId])
  @@index([supervisorId])
  @@index([createdAt])
  @@map("reviews")
}

// SAVED PROPERTIES

model SavedProperty {
  id          String    @id @default(cuid())
  notes       String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String

  @@unique([userId, propertyId])
  @@index([userId])
  @@map("saved_properties")
}

// INQUIRIES

model Inquiry {
  id            String        @id @default(cuid())
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  message       String
  status        InquiryStatus @default(PENDING)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String

  @@index([propertyId])
  @@index([status])
  @@map("inquiries")
}

// AUDIT LOGS

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  oldStatus   String?
  newStatus   String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// REPORT MODEL

model Report {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  content     String?   // HTML or JSON content
  fileUrl     String?   // If file is uploaded (PDF/DOCX)
  fileName    String?   // Original file name
  fileSize    Int?      // File size in bytes
  mimeType    String?   // application/pdf, etc.
  generatedBy String
  generator   User     @relation(fields: [generatedBy], references: [id])
  isPublished Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([propertyId])
  @@index([generatedBy])
  @@map("reports")
}