

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  CLIENT
  DATA_COLLECTOR
  SUPERVISOR
  ADMIN
  FINACIAL_INSTITUTION
}

enum PropertyStatus {
  PENDING
  ASSIGNED
  IN_FIELDWORK
  UNDER_REVIEW
  NEEDS_REVISION
  APPROVED
  PUBLISHED
  SOLD
  ARCHIVED
}

enum Condition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_RENOVATION
}

enum PropertyType {
  HOUSE
  APARTMENT
  VILLA
  LAND
  COMMERCIAL
}

enum RoadAccessType {
  PAVED
  UNPAVED
  DIRT
  UNDER_CONSTRUCTION
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
  REJECTED
}

enum ValuationMethod {
  AI
  MANUAL
}

enum InquiryStatus {
  PENDING
  RESPONDED
  CLOSED
}

enum InvitationStatus {
  PENDING
  COMPLETED  
  EXPIRED
  CANCELLED
}
enum AccessType {
  VIEW_ONLY
  REQUEST_VALUATION
  TRACK_PROGRESS
  FULL_ACCESS
}


// USER MODELS

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  phone         String?
  role          Role      @default(CLIENT)
  isActive      Boolean   @default(true)
  isEmailVerified Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addedById           String?
  addedBy             User?         @relation("AdminAddsEmployee", fields: [addedById], references: [id])
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?

  properties          Property[]    @relation("ClientProperties")

  assignments         Assignment[]  @relation("CollectorAssignments")

  reviews             Review[]      @relation("SupervisorReviews")

  employees           User[]        @relation("AdminAddsEmployee")
   invitationsCreated  Invitation[]   @relation("AdminCreatesInvitation")
  

  assignedProperties  Assignment[]  @relation("AdminAssignments")

  savedProperties     SavedProperty[]

  uploadedImages      Image[]       @relation("ImageUploader")

  auditLogs           AuditLog[]

  generatedReports Report[]
  
  bankId              String?
  bank                User?         @relation("BankManagesClient", fields: [bankId], references: [id])

    managedClients      User[]        @relation("BankManagesClient")
  
 grantedAccess       PropertyAccess[] @relation("InstitutionAccess")  // For banks/institutions receiving access
  requestedAccess     PropertyAccess[] @relation("ClientConsent")      // For clients giving consent


  @@index([email])
  @@index([role])
  @@map("users")
}

model Invitation {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  role          Role
  token         String   @unique
  expiresAt     DateTime
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
   createdById   String
  createdBy     User     @relation("AdminCreatesInvitation", fields: [createdById], references: [id])
  
  
  @@index([token])
  @@index([email])
  @@index([status])
  @@map("invitations")
}

// image model

model Image {
   id          String   @id @default(cuid())
  url         String
  publicId    String?
  altText     String?
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  uploadedBy  String
  fileSize    Int?
  mimeType    String?
  uploader    User      @relation("ImageUploader", fields: [uploadedBy], references: [id])

  propertyId  String?
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([uploadedBy])
  @@map("images")
}


// PROPERTY MODELS

model Property {
  id            String          @id @default(cuid())
  upiNumber     String          @unique
  idOrTin       String
  phoneNumber   String
  ownerName     String
  country       String          @default("Rwanda")
  province      String
  district      String
  sector        String
  cell          String
  village       String
  status        PropertyStatus  @default(PENDING)

  aiValuation   Float?
  aiConfidence  Float?
  aiFactors     Json?

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  soldAt        DateTime?
  archivedAt    DateTime?
  statusChangedAt DateTime?

  client        User            @relation("ClientProperties", fields: [clientId], references: [id])
  clientId      String

  fieldData     FieldData?

  assignment    Assignment?

  reviews       Review[]

  images        Image[]

  savedBy       SavedProperty[]
  inquiries     Inquiry[]
  reports       Report[]

sharedWith      PropertyAccess[]
  isPublic        Boolean   @default(false)
  
  @@index([status])
  @@index([clientId])
  @@index([province, district])
  @@index([createdAt])
  @@map("properties")
}

// ASSIGNMENT MODEL

model Assignment {
  id                  String    @id @default(cuid())
  assignedAt          DateTime  @default(now())
  emailSentAt         DateTime?
  verifiedAt          DateTime?
  verificationToken   String    @unique @default(cuid())
  notes               String?

  property            Property  @relation(fields: [propertyId], references: [id])
  propertyId          String    @unique

  collector           User      @relation("CollectorAssignments", fields: [collectorId], references: [id])
  collectorId         String

  assignedBy          User?     @relation("AdminAssignments", fields: [assignedById], references: [id])
  assignedById        String?

  @@index([collectorId])
  @@index([assignedById])
  @@index([verificationToken])
  @@index([assignedAt])
  @@map("assignments")
}

// FIELD DATA

model FieldData {
  id String @id @default(cuid())

  // location
  latitude Float
  longitude Float
  microZone String?
  neighborhood String?
  urbanDensity String?
  safetyIndex Float?
  noiseLevel String?

  gpsCapturedAt DateTime?
  gpsAccuracy Float?

  // core structure
  propertyType PropertyType?
  condition Condition?
  bedrooms Int?
  bathrooms Float?
  landSize Float?
  buildingSize Float?
  yearBuilt Int?
  parkingSpaces Int? @default(0)

  // amenities
  hasGarden Boolean? @default(false)
  gardenSize Float?
  gardenType String?

  hasAnnex Boolean? @default(false)
  annexType String?
  annexSize Float?
  annexBedrooms Int?
  annexBathrooms Float?

  hasGate Boolean? @default(false)
  gateType String?
  gateMaterial String?

  hasFence Boolean? @default(false)
  fenceType String?
  fenceHeight Float?

  // utilities
  hasElectricity Boolean? @default(true)
  hasWaterSupply Boolean? @default(true)
  hasWaterTank Boolean? @default(false)

 hasSwimmingPool     Boolean?        @default(false)
  hasGym              Boolean?        @default(false)
  hasSmartHome        Boolean?        @default(false)
  hasSolarPanels      Boolean?        @default(false)
  hasBackupGenerator  Boolean?        @default(false)
  hasSecuritySystem   Boolean?        @default(false)
  hasLandscapedGarden Boolean?        @default(false)
  hasModernKitchen    Boolean?        @default(false)
  hasAirConditioning  Boolean?        @default(false)
  hasFireplace        Boolean?        @default(false)
  hasBalcony          Boolean?        @default(false)
  hasGarage           Boolean?        @default(false)
  hasStaffQuarters    Boolean?        @default(false)
  hasStorageRoom      Boolean?        @default(false)
  hasWaterHeater      Boolean?        @default(false)
  hasIntercom         Boolean?        @default(false)
  viewType            String?         @default("None")
  
  // land characteristics
  floodRisk Boolean? @default(false)
  landSlope String?

  // building
  floorMaterial String?
  roofType String?
  propertyCategory String?

  // market timing
  listingDate DateTime?
  daysOnMarket Int?
  marketTrend String?
  pricePerSqm Float?
  lastSoldNearbyPrice Float?

  // infrastructure
  nearestSchoolKm Float?
  nearestHospitalKm Float?
  nearestTransportKm Float?
  nearestMarketKm Float?
  roadAccessType RoadAccessType?

  // demand signals
  viewQualityScore Float?
  luxuryScore Float?
  renovationLevel Float?
  furnishingStatus String?

  interestCount Int? @default(0)
  saveCount Int? @default(0)
  inquiryCount Int? @default(0)

  // AI results
  valuationAmount Float?
  valuationConfidence Float?
  valuationMethod ValuationMethod?

  notes String?

  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String @unique

  @@index([propertyId])
  @@index([latitude, longitude])
  @@index([microZone])
  @@index([listingDate])
  @@map("field_data")
}

model PropertySale {
  id            String   @id @default(cuid())

  district      String
  sector        String?
  cell          String?

  landSize      Float
  buildingSize  Float?

  bedrooms      Int?
  bathrooms     Float?

  propertyType  String
  category      String

  yearBuilt     Int?

  floorMaterial String?
  roofType      String?

  hasGarden     Boolean?
  hasFence      Boolean?
  hasGate       Boolean?

  roadAccessType String

  nearestSchoolKm   Float?
  nearestHospitalKm  Float?
  nearestMarketKm    Float?

  soldPrice     Float
  soldAt        DateTime @default(now())

  createdAt     DateTime @default(now())

  @@index([district])
  @@index([soldAt])
}

// REVIEW MODEL

model Review {
  id            String          @id @default(cuid())
  comment       String
  decision      ReviewDecision
  createdAt     DateTime        @default(now())

  property      Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String

  supervisor    User            @relation("SupervisorReviews", fields: [supervisorId], references: [id])
  supervisorId  String

  @@index([propertyId])
  @@index([supervisorId])
  @@index([createdAt])
  @@map("reviews")
}

// SAVED PROPERTIES

model SavedProperty {
  id          String    @id @default(cuid())
  notes       String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String

  @@unique([userId, propertyId])
  @@index([userId])
  @@map("saved_properties")
}

// INQUIRIES

model Inquiry {
  id            String        @id @default(cuid())
  buyerName     String
  buyerEmail    String
  buyerPhone    String?
  message       String
  status        InquiryStatus @default(PENDING)
  response      String?
  respondedAt   DateTime?
  createdAt     DateTime      @default(now())

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String

  @@index([propertyId])
  @@index([status])
  @@map("inquiries")
}

// AUDIT LOGS

model AuditLog {
  id          String    @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  oldStatus   String?
  newStatus   String?
  details     Json?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  userId      String

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PropertyAccess {
  id              String   @id @default(cuid())
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  institutionId   String
  institution     User     @relation("InstitutionAccess", fields: [institutionId], references: [id])
  
  accessType      AccessType
  grantedAt       DateTime @default(now())
  grantedBy       String
  expiresAt       DateTime?
  
  // For pending/under review properties
  accessRequestedAt DateTime?
  accessApprovedAt  DateTime?
  clientConsent     Boolean?  // Client must consent for bank to see
  
  // Add relation to client (the property owner)
  clientId        String?
  client          User?    @relation("ClientConsent", fields: [clientId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([propertyId, institutionId])
  @@map("property_access")
}

// REPORT MODEL

model Report {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title       String
  content     String?   // HTML or JSON content
  fileUrl     String?   // If file is uploaded (PDF/DOCX)
  fileName    String?   // Original file name
  fileSize    Int?      // File size in bytes
  mimeType    String?   // application/pdf, etc.
  generatedBy String
  generator   User     @relation(fields: [generatedBy], references: [id])
  isPublished Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([propertyId])
  @@index([generatedBy])
  @@map("reports")
}